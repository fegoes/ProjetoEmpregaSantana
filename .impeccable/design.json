      "css": ".ds-search{display:flex;align-items:center;gap:10px;height:48px;padding:0 16px;border:1px solid var(--border,oklch(0.90 0 0));border-radius:9999px;background:var(--card,#fff);color:var(--muted-foreground,oklch(0.50 0 0));max-width:420px}.ds-search input{flex:1;border:0;outline:none;background:transparent;font:400 16px Poppins,system-ui,sans-serif;color:var(--foreground,oklch(0.321 0 0))}.ds-search:focus-within{border-color:var(--primary,oklch(0.504 0.148 255.8));box-shadow:0 0 0 3px oklch(0.504 0.148 255.8/0.4)}"
